# ══════════════════════════════════════════════════════════════
# Sensei AI Tutor — Environment Configuration
# Copy to .env and fill in. Never commit .env.
# ══════════════════════════════════════════════════════════════

# ── Authentication ────────────────────────────────────────────
PC_AGENT_SECRET=generate-a-long-random-string
JWT_SECRET=generate-another-long-random-string

# ── Ports ─────────────────────────────────────────────────────
PORT=3848
PC_AGENT_PORT=3847
PC_AGENT_URL=http://127.0.0.1:3847

# ── LLM / AI ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Model for direct API calls (quick conversational responses)
SENSEI_MODEL=claude-sonnet-4-6
# Model for Claude Code CLI (complex tasks)
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT_MS=180000

# ── ElevenLabs TTS (premium voice for short responses) ────────
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# Max chars to use ElevenLabs (longer uses Edge TTS for cost savings)
ELEVENLABS_MAX_CHARS=200
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Edge TTS (free fallback for longer responses) ─────────────
SENSEI_TTS_VOICE=en-US-AndrewMultilingualNeural
SENSEI_TTS_RATE=+5%
# Audio output device substring (leave empty for system default)
SENSEI_TTS_DEVICE=

# ── Voice Listening ───────────────────────────────────────────
# Mic device index (leave empty for system default; run --list-mics to see options)
LISTEN_DEVICE_INDEX=
LISTEN_LANGUAGE=en-US
LISTEN_PHRASE_LIMIT=10
LISTEN_SILENCE_SEC=1.2
LISTEN_ENERGY_THRESHOLD=300
# Wake word (leave empty for always-on mode)
SENSEI_LISTEN_WAKE=
# How Sensei addresses you
SENSEI_USER_NAME=Utkarsh

# ── TTS Cache ─────────────────────────────────────────────────
# Leave empty for default temp directory cache
SENSEI_TTS_CACHE=

# ── Workspace ─────────────────────────────────────────────────
# Working directory for code/file tasks
PC_AGENT_WORKSPACE=E:\career\career-compass

# ── Database (optional — for session persistence) ─────────────
# SENSEI_SQLITE_PATH=./data/sensei.db
